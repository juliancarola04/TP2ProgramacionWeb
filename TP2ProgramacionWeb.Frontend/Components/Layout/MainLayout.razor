@inherits LayoutComponentBase

<MudThemeProvider IsDarkMode="_darkMode"/>
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />


<MudLayout>
    <MudAppBar>
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        <MudSpacer />
        <MudText Typo="Typo.h5" Align="Align.Center">TP2 Programación Web</MudText>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Brightness3" Color="Color.Inherit" Edge="Edge.Start" OnClick="((e) => DarkModeToggle())"></MudIconButton>
    </MudAppBar>
    
    <MudDrawer @bind-Open="_drawerAbierto" ClipMode="DrawerClipMode.Always" Variant="DrawerVariant.Temporary">
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All">
                Inicio
            </MudNavLink>
            <MudNavGroup Title="CRUD" Expanded="true">
                <MudNavGroup Title="Proveedores">
                    <MudNavLink Href="/proveedores/insert" Match="NavLinkMatch.Prefix">
                        Insertar
                    </MudNavLink>
                    <MudNavLink Href="/proveedores/view" Match="NavLinkMatch.Prefix">
                        Observar
                    </MudNavLink>
                </MudNavGroup>
                <MudNavGroup Title="Categorias">
                    <MudNavLink Href="/categorias/insert" Match="NavLinkMatch.Prefix">
                        Insertar
                    </MudNavLink>
                    <MudNavLink Href="/categorias/view" Match="NavLinkMatch.Prefix">
                        Observar
                    </MudNavLink>
                </MudNavGroup>
                <MudNavGroup Title="Productos">
                    <MudNavLink Href="/productos/insert" Match="NavLinkMatch.Prefix">
                        Insertar
                    </MudNavLink>
                    <MudNavLink Href="/productos/view" Match="NavLinkMatch.Prefix">
                        Observar
                    </MudNavLink>
                </MudNavGroup>
                <MudNavLink Href="/ingresos">
                    Ingresos
                </MudNavLink>
            </MudNavGroup>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

@code
{
    bool _drawerAbierto = false;
    bool _darkMode = true;

    void DrawerToggle()
    {
        _drawerAbierto = !_drawerAbierto;
    }

    void DarkModeToggle()
    {
        _darkMode = !_darkMode;
    }
}
