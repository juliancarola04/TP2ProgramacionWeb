@page "/"
@using Microsoft.AspNetCore.Identity.Data
@using TP2ProgramacionWeb.Frontend.DTO.Auth.Response
@using TP2ProgramacionWeb.Frontend.Services
@using TP2ProgramacionWeb.Frontend.Viewmodel
@using Dto = TP2ProgramacionWeb.Frontend.DTO.Auth.Request
@inject RegisterService registerService
@inject JwtAuthenticationStateProvider auth
@rendermode InteractiveServer

<PageTitle>Crear Cuenta</PageTitle>

<div class="container">
    <div class="row justify-content-center align-items-center min-vh-100">
        <div class="col-5">
            <div class="card ">
                <div class="card-body">
                    <h1 class="card-title text-center">
                        Registrarse
                    </h1>
                    <p class="mb-3 text-center">
                        Ingresá los datos para registrarte en el sistema
                    </p>
                    
                    <EditForm Model="@_registerViewModel" OnValidSubmit="Registrar">
                        <DataAnnotationsValidator/>
                        
                        
                        <div class="">
                            <label class="form-label">
                                Usuario
                            </label>
                            <InputText class="form-control" @bind-Value="_registerViewModel.Username"/>
                            <ValidationMessage For="@(() => _registerViewModel.Username)" />
                        </div>

                        <div class="mt-3">
                            <label class="form-label">
                                Contraseña
                            </label>
                            <InputText class="form-control" @bind-Value="_registerViewModel.Password"/>
                            <ValidationMessage For="@(() => _registerViewModel.Password)" />
                        </div>

                        <div class="mt-3">
                            <label class="form-label">
                                E-Mail
                            </label>
                            <InputText class="form-control" @bind-Value="_registerViewModel.Email"/>
                            <ValidationMessage For="@(() => _registerViewModel.Email)" />
                        </div>

                        <div class="d-flex justify-content-center">
                            <button class="btn btn-primary mt-3">
                                Registrarse
                            </button>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(mensajeError))
                        {
                            <p class="text-center text-danger">
                                @mensajeError
                            </p>
                        }

                        <div class="d-flex justify-content-center mt-3">
                            <p class="bg-secondary-subtle px-3 py-1 rounded-2">
                                Ya tenés cuenta? <a href="/login">Inicia sesión</a>
                            </p>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private RegisterViewModel _registerViewModel = new();

    private string mensajeError;

    private async Task Registrar()
    {
        Dto.RegisterRequest registerRequest = new Dto.RegisterRequest(
            _registerViewModel.Username,
            _registerViewModel.Password,
            _registerViewModel.Email
        );

        try
        {
            RegisterResponse registerResponse = await registerService.Registrarse(registerRequest);
            mensajeError = registerResponse.Token;
            auth.IniciarSesion(registerResponse.Token);
        }
        catch (Exception e)
        {
            mensajeError = e.Message;
        }
    }
}