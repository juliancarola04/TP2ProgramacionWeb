@page "/productos/insert"
@using TP2ProgramacionWeb.Frontend.DTO.Categoria.Response
@using TP2ProgramacionWeb.Frontend.DTO.Paginado.Request.Categoria
@using TP2ProgramacionWeb.Frontend.DTO.Producto.Request
@using TP2ProgramacionWeb.Frontend.Services
@using TP2ProgramacionWeb.Frontend.Utilidades
@using TP2ProgramacionWeb.Frontend.Viewmodel
@inject ProductoService ProductoService
@inject CategoriaService CategoriaService
@inject ManejadorErroresUi Errores

<PageTitle>Insertar productos</PageTitle>

<div class="d-flex justify-content-center align-center" style="min-height: 75vh;">
    <MudContainer MaxWidth="MaxWidth.Medium">
        <EditForm Model="@_productoViewModel" OnValidSubmit="OnValidSubmit">
            <DataAnnotationsValidator />
            <MudGrid>
                <MudItem xs="12" sm="7">
                    <MudCard>
                        <MudCardContent>
                            <MudTextField Label="Nombre" HelperText="Max. 60 caracteres" MaxLength="60"
                                          @bind-Value="_productoViewModel.Nombre"
                                          For="@(() => _productoViewModel.Nombre)" />

                            <MudSelect T="int" Label="Categoría" Class="mt-3"
                                       @bind-Value="_productoViewModel.CategoriaId"
                                       For="@(() => _productoViewModel.CategoriaId)"
                                       Disabled="@(_categorias.Count == 0)">
                                @foreach (CategoriaResponse categoria in _categorias)
                                {
                                    <MudSelectItem T="int" Value="@categoria.Id">@categoria.Nombre</MudSelectItem>
                                }
                            </MudSelect>

                            <MudNumericField T="decimal" Label="Precio Compra" Class="mt-3"
                                             Min="0" HideSpinButtons="true"
                                             Adornment="Adornment.Start" AdornmentText="$"
                                             HelperText="Se actualiza solo con cada ingreso de stock."
                                             @bind-Value="_productoViewModel.PrecioCompra"
                                             For="@(() => _productoViewModel.PrecioCompra)" />

                            <MudNumericField T="decimal" Label="Precio Venta" Class="mt-3"
                                             Min="0" HideSpinButtons="true"
                                             Adornment="Adornment.Start" AdornmentText="$"
                                             @bind-Value="_productoViewModel.PrecioVenta"
                                             For="@(() => _productoViewModel.PrecioVenta)" />
                        </MudCardContent>

                        <MudCardActions>
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                                       Class="ml-auto" Disabled="@(_guardando || _categorias.Count == 0)">
                                Guardar
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>

                <MudItem xs="12" sm="5">
                    <MudPaper Class="pa-4 mud-height-full">
                        <MudText Typo="Typo.subtitle2">Resumen validaciones</MudText>

                        @if (!_cargandoCategorias && _categorias.Count == 0)
                        {
                            <MudAlert Severity="Severity.Info" Class="mt-2">
                                No hay categorías cargadas. Creá una en
                                <MudLink Href="/categorias/insert">Categorías → Insertar</MudLink>
                                antes de agregar productos.
                            </MudAlert>
                        }

                        @if (_exito)
                        {
                            <MudText Color="Color.Success">Se guardó el producto con éxito.</MudText>
                        }
                        else
                        {
                            <MudText Color="Color.Error">
                                <ValidationSummary />
                            </MudText>
                        }
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </EditForm>
    </MudContainer>
</div>

@code {
    private ProductoViewModel _productoViewModel = new();
    private List<CategoriaResponse> _categorias = [];

    private bool _exito;
    private bool _guardando;
    private bool _cargandoCategorias = true;

    protected override async Task OnInitializedAsync()
    {
        var parametros = new ParametroPaginacionCategoriaRequest
        {
            NumeroPagina = 1,
            TamanoPagina = 50 // máximo que permite el servicio
        };

        var respuesta = await Errores.ObtenerAsync(() => CategoriaService.ObtenerTodas(parametros));
        _categorias = respuesta?.Datos.ToList() ?? [];
        _cargandoCategorias = false;
    }

    private async Task OnValidSubmit(EditContext editContext)
    {
        _guardando = true;
        _exito = false;

        CrearProductoRequest request = new CrearProductoRequest(
            _productoViewModel.Nombre,
            _productoViewModel.PrecioCompra,
            _productoViewModel.PrecioVenta,
            _productoViewModel.CategoriaId
        );

        bool seGuardo = await Errores.EjecutarAsync(() => ProductoService.Crear(request));

        if (seGuardo)
        {
            _exito = true;
            _productoViewModel = new(); // limpia el formulario para cargar otro
        }

        _guardando = false;
    }
}