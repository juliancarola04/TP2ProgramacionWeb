@page "/proveedores"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.AspNetCore.Mvc
@using TP2ProgramacionWeb.Frontend.DTO.Paginado.Request.Proveedor
@using TP2ProgramacionWeb.Frontend.Viewmodel
@using TP2ProgramacionWeb.Frontend.Services
@using TP2ProgramacionWeb.Frontend.DTO.Proveedor.Request
@using TP2ProgramacionWeb.Frontend.DTO.Proveedor.Response
@using TP2ProgramacionWeb.Frontend.Models.ModeloAuxiliar
@rendermode InteractiveServer
@inject ProveedorService ProveedorService

<PageTitle>Gestionar Proveedores</PageTitle>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-5">
            <div class="card">
                <div class="card-body">
                    <h1 class="card-title text-center">
                        Proveedor
                    </h1>
                    <p class="mb-3 text-center">
                        Ingresá los datos para registrar un proveedor en el sistema
                    </p>
                    
                    <EditForm Model="@_proveedorViewModel" OnValidSubmit="Guardar">
                        <DataAnnotationsValidator/>
                        
                        
                        <div class="">
                            <label class="form-label">
                                Razon Social
                            </label>
                            <InputText class="form-control" @bind-Value="_proveedorViewModel.RazonSocial"/>
                            <ValidationMessage For="@(() => _proveedorViewModel.RazonSocial)" />
                        </div>

                        <div class="mt-3">
                            <label class="form-label">
                                CUIT
                            </label>
                            <InputText class="form-control" @bind-Value="_proveedorViewModel.CUIT"/>
                            <ValidationMessage For="@(() => _proveedorViewModel.CUIT)" />
                        </div>

                        <div class="mt-3">
                            <label class="form-label">
                                E-Mail
                            </label>
                            <InputText class="form-control" @bind-Value="_proveedorViewModel.Email"/>
                            <ValidationMessage For="@(() => _proveedorViewModel.Email)" />
                        </div>
                        
                        <div class="mt-3">
                            <label class="form-label">
                                Telefono
                            </label>
                            <InputText class="form-control" @bind-Value="_proveedorViewModel.Telefono"/>
                            <ValidationMessage For="@(() => _proveedorViewModel.Telefono)" />
                        </div>
                        
                        <div class="mt-3">
                            <label class="form-label">
                                Direccion
                            </label>
                            <InputText class="form-control" @bind-Value="_proveedorViewModel.Direccion"/>
                            <ValidationMessage For="@(() => _proveedorViewModel.Direccion)" />
                        </div>

                        <div class="d-flex justify-content-center">
                            <button class="btn btn-primary mt-3">
                                Guardar
                            </button>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(_mensajeError))
                        {
                            <p class="text-center text-danger">
                                @_mensajeError
                            </p>
                        }
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

<QuickGrid Items="_proveedores.AsQueryable()" Class="table">
    <Microsoft.AspNetCore.Components.QuickGrid.PropertyColumn Property="p => p.Id" Title="ID" />
    <Microsoft.AspNetCore.Components.QuickGrid.PropertyColumn Property="p => p.RazonSocial" Title="Razón social" />
    <Microsoft.AspNetCore.Components.QuickGrid.PropertyColumn Property="p => p.Cuit" Title="CUIT" />
    <Microsoft.AspNetCore.Components.QuickGrid.PropertyColumn Property="p => p.Direccion" Title="Dirección" />
    <Microsoft.AspNetCore.Components.QuickGrid.PropertyColumn Property="p => p.Email" Title="Email" />
    <Microsoft.AspNetCore.Components.QuickGrid.PropertyColumn Property="p => p.Telefono" Title="Teléfono" />
    
    <Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn Title="Acciones" Context="proveedor">
        <button @onclick="() => Editar(proveedor)" class="btn btn-success">Editar</button>
        <button @onclick="() => Eliminar(proveedor)"class="btn btn-danger">Eliminar</button>
    </Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn>
</QuickGrid>

@code {
    private ProveedorViewModel _proveedorViewModel = new();
    
    // Solo se van a mostrar 30.
    private List<ObtenerProveedorResponse> _proveedores = [];

    private int idProveedorEdit = 0;

    private string? _mensajeError = null;

    private async Task Guardar()
    {
        if (idProveedorEdit == 0)
        {
            CrearProveedorRequest crearProveedorRequest = new CrearProveedorRequest(
                _proveedorViewModel.RazonSocial,
                _proveedorViewModel.CUIT,
                _proveedorViewModel.Direccion,
                _proveedorViewModel.Email,
                _proveedorViewModel.Telefono
            );
            
            try
            {
                CrearProveedorResponse crearProveedorResponse = await ProveedorService.Crear(crearProveedorRequest);
                await CargarProveedores();

                _proveedorViewModel = new ProveedorViewModel();
            }
            catch (Exception ex)
            {
                _mensajeError = ex.Message;
            }
        }
        else
        {
            ActualizarProveedorRequest actualizarProveedorRequest = new ActualizarProveedorRequest(
                _proveedorViewModel.RazonSocial,
                _proveedorViewModel.CUIT,
                _proveedorViewModel.Direccion,
                _proveedorViewModel.Email,
                _proveedorViewModel.Telefono
            );

            try
            {
                await ProveedorService.Actualizar(idProveedorEdit, actualizarProveedorRequest);
                await CargarProveedores();
                
                _proveedorViewModel = new ProveedorViewModel();
                idProveedorEdit = 0;
            }
            catch (Exception ex)
            {
                _mensajeError = ex.Message;
            }
        }
    }

    private async Task CargarProveedores()
    {
        PaginadoResponse<ObtenerProveedorResponse>? resultado = await ProveedorService.ObtenerTodos(new ParametroPaginacionProveedorRequest
        {
            NumeroPagina = 1,
            TamanoPagina = 50
        });

        _proveedores = resultado.Datos;


    }

    private async Task Editar(ObtenerProveedorResponse proveedor)
    {
        idProveedorEdit = proveedor.Id;

        _proveedorViewModel = new ProveedorViewModel
        {
            RazonSocial = proveedor.RazonSocial,
            CUIT = proveedor.Cuit,
            Direccion = proveedor.Direccion,
            Email = proveedor.Email,
            Telefono = proveedor.Telefono
        };
    }

    private async Task Eliminar(ObtenerProveedorResponse proveedor)
    {
        
        try
        {
            await ProveedorService.DarDeBaja(proveedor.Id);
            await CargarProveedores();

            _proveedorViewModel = new ProveedorViewModel();
        }
        catch (Exception ex)
        {
            _mensajeError = ex.Message;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarProveedores();
    }
}
